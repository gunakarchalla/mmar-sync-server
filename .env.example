# Copy this file to .env and fill in JWT_SECRET.
#
# JWT_SECRET must be the same secret mmar-server signs its tokens with: this
# server verifies them locally instead of calling back to the API. There is no
# fallback, so the process refuses to start while it is unset.
#   openssl rand -base64 48

PORT=8060
JWT_SECRET=
API_URL=http://mmar-server:8000
ACCESS_REVALIDATE_INTERVAL_MS=15000
